	"protocolDefinitions": {
		"bodyFatProtocols": [
			{
				"id": "slaughterTricepsSubscapular",
				"label": {
					"pt-BR": "Slaughter — tríceps + subescapular",
					"en": "Slaughter — triceps + subscapular"
				},
				"ageRange": {
					"max": 16
				},
				"biologicalSex": ["male", "female"],
				"output": "bodyFatPercent",
				"requires": ["biologicalSex", "ageYears", "tricepsSkinfoldMm", "subscapularSkinfoldMm"],
				"formulas": [
					{
						"condition": "biologicalSex === 'male' AND S2 <= 35",
						"expression": "bodyFatPercent = 1.21 * S2 - 0.008 * (S2 ** 2) - 1.7"
					},
					{
						"condition": "biologicalSex === 'male' AND S2 > 35",
						"expression": "bodyFatPercent = 0.783 * S2 + 1.6"
					},
					{
						"condition": "biologicalSex === 'female' AND S2 <= 35",
						"expression": "bodyFatPercent = 1.33 * S2 - 0.013 * (S2 ** 2) - 2.5"
					},
					{
						"condition": "biologicalSex === 'female' AND S2 > 35",
						"expression": "bodyFatPercent = 0.546 * S2 + 9.7"
					}
				],
				"intermediateValues": [
					{
						"key": "S2",
						"expression": "tricepsSkinfoldMm + subscapularSkinfoldMm"
					}
				],
				"requiresDensityConverter": false
			},
			{
				"id": "jacksonPollock3",
				"label": {
					"pt-BR": "Jackson-Pollock 3 dobras",
					"en": "Jackson-Pollock 3-site"
				},
				"ageRange": {
					"min": 17,
					"max": 60
				},
				"biologicalSex": ["male", "female"],
				"output": "bodyDensity",
				"requiresBySex": {
					"male": [
						"biologicalSex",
						"ageYears",
						"chestSkinfoldMm",
						"abdominalSkinfoldMm",
						"thighSkinfoldMm",
						"densityConverterId"
					],
					"female": [
						"biologicalSex",
						"ageYears",
						"tricepsSkinfoldMm",
						"suprailiacSkinfoldMm",
						"thighSkinfoldMm",
						"densityConverterId"
					]
				},
				"formulas": [
					{
						"condition": "biologicalSex === 'male'",
						"expression": "bodyDensity = 1.10938 - 0.0008267 * S3 + 0.0000016 * (S3 ** 2) - 0.0002574 * ageYears"
					},
					{
						"condition": "biologicalSex === 'female'",
						"expression": "bodyDensity = 1.0994921 - 0.0009929 * S3 + 0.0000023 * (S3 ** 2) - 0.0001392 * ageYears"
					}
				],
				"intermediateValues": [
					{
						"key": "S3",
						"condition": "biologicalSex === 'male'",
						"expression": "chestSkinfoldMm + abdominalSkinfoldMm + thighSkinfoldMm"
					},
					{
						"key": "S3",
						"condition": "biologicalSex === 'female'",
						"expression": "tricepsSkinfoldMm + suprailiacSkinfoldMm + thighSkinfoldMm"
					}
				],
				"requiresDensityConverter": true
			},
			{
				"id": "jacksonPollock7",
				"label": {
					"pt-BR": "Jackson-Pollock 7 dobras",
					"en": "Jackson-Pollock 7-site"
				},
				"ageRange": {
					"min": 17,
					"max": 60
				},
				"biologicalSex": ["male", "female"],
				"output": "bodyDensity",
				"requires": [
					"biologicalSex",
					"ageYears",
					"chestSkinfoldMm",
					"midaxillarySkinfoldMm",
					"tricepsSkinfoldMm",
					"subscapularSkinfoldMm",
					"abdominalSkinfoldMm",
					"suprailiacSkinfoldMm",
					"thighSkinfoldMm",
					"densityConverterId"
				],
				"formulas": [
					{
						"condition": "biologicalSex === 'male'",
						"expression": "bodyDensity = 1.112 - 0.00043499 * S7 + 0.00000055 * (S7 ** 2) - 0.00028826 * ageYears"
					},
					{
						"condition": "biologicalSex === 'female'",
						"expression": "bodyDensity = 1.097 - 0.00046971 * S7 + 0.00000056 * (S7 ** 2) - 0.00012828 * ageYears"
					}
				],
				"intermediateValues": [
					{
						"key": "S7",
						"expression": "chestSkinfoldMm + midaxillarySkinfoldMm + tricepsSkinfoldMm + subscapularSkinfoldMm + abdominalSkinfoldMm + suprailiacSkinfoldMm + thighSkinfoldMm"
					}
				],
				"requiresDensityConverter": true
			},
			{
				"id": "durninWomersley4OlderAdults",
				"label": {
					"pt-BR": "Durnin-Womersley 4 dobras — maiores de 60 anos",
					"en": "Durnin-Womersley 4-site — older adults"
				},
				"ageRange": {
					"min": 61
				},
				"biologicalSex": ["male", "female"],
				"output": "bodyDensity",
				"requires": [
					"biologicalSex",
					"ageYears",
					"bicepsSkinfoldMm",
					"tricepsSkinfoldMm",
					"subscapularSkinfoldMm",
					"suprailiacSkinfoldMm",
					"densityConverterId"
				],
				"formulas": [
					{
						"condition": "biologicalSex === 'male'",
						"expression": "bodyDensity = 1.1715 - 0.0779 * log10(S4)"
					},
					{
						"condition": "biologicalSex === 'female'",
						"expression": "bodyDensity = 1.1339 - 0.0645 * log10(S4)"
					}
				],
				"intermediateValues": [
					{
						"key": "S4",
						"expression": "bicepsSkinfoldMm + tricepsSkinfoldMm + subscapularSkinfoldMm + suprailiacSkinfoldMm"
					}
				],
				"requiresDensityConverter": true
			}
		],
		"densityConverters": [
			{
				"id": "siri",
				"label": {
					"pt-BR": "Siri",
					"en": "Siri"
				},
				"requires": ["bodyDensity"],
				"expression": "bodyFatPercent = (495 / bodyDensity) - 450"
			},
			{
				"id": "brozek",
				"label": {
					"pt-BR": "Brozek",
					"en": "Brozek"
				},
				"requires": ["bodyDensity"],
				"expression": "bodyFatPercent = (457 / bodyDensity) - 414.2"
			}
		]
	},
	"calculationDefinitions": [
		{
			"id": "quetelet",
			"group": "bmi",
			"label": {
				"pt-BR": "IMC tradicional — Quételet / OMS",
				"en": "Traditional BMI — Quetelet / WHO"
			},
			"requires": ["bodyMassKg", "heightCm"],
			"expression": "bmiQuetelet = bodyMassKg / ((heightCm / 100) ** 2)"
		},
		{
			"id": "greccoFmrpUsp",
			"group": "bmi",
			"label": {
				"pt-BR": "Novo IMC — Grecco / FMRP-USP",
				"en": "New BMI — Grecco / FMRP-USP"
			},
			"requires": ["bodyMassKg", "heightCm", "fatMassKg"],
			"expression": "bmiGreccoFmrpUsp = ((3 * bodyMassKg) + (4 * fatMassKg)) / heightCm"
		},
		{
			"id": "trefethen",
			"group": "bmi",
			"label": {
				"pt-BR": "Novo IMC — Nick Trefethen",
				"en": "New BMI — Nick Trefethen"
			},
			"requires": ["bodyMassKg", "heightCm"],
			"expression": "bmiTrefethen = 1.3 * bodyMassKg / ((heightCm / 100) ** 2.5)"
		},
		{
			"id": "melaoJr",
			"group": "bmi",
			"label": {
				"pt-BR": "IMC — Hinderburg Melão Jr.",
				"en": "BMI — Hinderburg Melao Jr."
			},
			"requires": ["bodyMassKg", "heightCm"],
			"expression": "bmiMelaoJr = 1.7 * bodyMassKg / ((heightCm / 100) ** 3.06)"
		},
		{
			"id": "waistHipRatio",
			"group": "healthIndex",
			"label": {
				"pt-BR": "Relação cintura-quadril",
				"en": "Waist-hip ratio"
			},
			"requires": ["waistCircumferenceCm", "hipCircumferenceCm"],
			"expression": "waistHipRatio = waistCircumferenceCm / hipCircumferenceCm"
		},
		{
			"id": "waistHeightRatio",
			"group": "healthIndex",
			"label": {
				"pt-BR": "Relação cintura-estatura",
				"en": "Waist-height ratio"
			},
			"requires": ["waistCircumferenceCm", "heightCm"],
			"expression": "waistHeightRatio = waistCircumferenceCm / heightCm"
		},
		{
			"id": "fatMass",
			"group": "bodyComposition",
			"label": {
				"pt-BR": "Massa gorda",
				"en": "Fat mass"
			},
			"requires": ["bodyMassKg", "bodyFatPercent"],
			"expression": "fatMassKg = bodyMassKg * (bodyFatPercent / 100)"
		},
		{
			"id": "fatFreeMass",
			"group": "bodyComposition",
			"label": {
				"pt-BR": "Massa livre de gordura",
				"en": "Fat-free mass"
			},
			"requires": ["bodyMassKg", "fatMassKg"],
			"expression": "fatFreeMassKg = bodyMassKg - fatMassKg"
		},
		{
			"id": "fatFreeMassPercent",
			"group": "bodyComposition",
			"label": {
				"pt-BR": "Percentual de massa livre de gordura",
				"en": "Fat-free mass percentage"
			},
			"requires": ["fatFreeMassKg", "bodyMassKg"],
			"expression": "fatFreeMassPercent = (fatFreeMassKg / bodyMassKg) * 100"
		},
		{
			"id": "fatToFatFreeMassRatio",
			"group": "bodyComposition",
			"label": {
				"pt-BR": "Razão massa gorda / massa livre de gordura",
				"en": "Fat mass / fat-free mass ratio"
			},
			"requires": ["fatMassKg", "fatFreeMassKg"],
			"expression": "fatToFatFreeMassRatio = fatMassKg / fatFreeMassKg"
		},
		{
			"id": "targetBodyMass",
			"group": "bodyComposition",
			"label": {
				"pt-BR": "Massa corporal alvo",
				"en": "Target body mass"
			},
			"requires": ["fatFreeMassKg", "targetBodyFatPercent"],
			"expression": "targetBodyMassKg = fatFreeMassKg / (1 - targetBodyFatPercent / 100)"
		},
		{
			"id": "mifflinStJeorBmr",
			"group": "energy",
			"label": {
				"pt-BR": "Taxa metabólica basal — Mifflin-St Jeor",
				"en": "Basal metabolic rate — Mifflin-St Jeor"
			},
			"requires": ["biologicalSex", "bodyMassKg", "heightCm", "ageYears"],
			"expressions": [
				{
					"condition": "biologicalSex === 'male'",
					"expression": "bmrKcalDay = (10 * bodyMassKg) + (6.25 * heightCm) - (5 * ageYears) + 5"
				},
				{
					"condition": "biologicalSex === 'female'",
					"expression": "bmrKcalDay = (10 * bodyMassKg) + (6.25 * heightCm) - (5 * ageYears) - 161"
				}
			]
		},
		{
			"id": "katchMcArdleBmr",
			"group": "energy",
			"label": {
				"pt-BR": "Taxa metabólica basal — Katch-McArdle",
				"en": "Basal metabolic rate — Katch-McArdle"
			},
			"requires": ["fatFreeMassKg"],
			"expression": "bmrKatchMcArdleKcalDay = 370 + (21.6 * fatFreeMassKg)"
		},
		{
			"id": "tdee",
			"group": "energy",
			"label": {
				"pt-BR": "Gasto energético diário estimado",
				"en": "Estimated total daily energy expenditure"
			},
			"requires": ["bmrKcalDay", "activityFactor"],
			"expression": "tdeeKcalDay = bmrKcalDay * activityFactor"
		}
	],
	"dynamicRequirementRules": [
		{
			"id": "selectedProtocolRequiredMeasurements",
			"description": {
				"pt-BR": "As dobras obrigatórias são determinadas pelo protocolo de percentual de gordura selecionado.",
				"en": "Required skinfolds are determined by the selected body fat protocol."
			},
			"rule": "all selectedBodyFatProtocol.requires fields must be valid"
		},
		{
			"id": "densityConverterRequired",
			"description": {
				"pt-BR": "Se o protocolo gerar densidade corporal, o conversor Siri ou Brozek é obrigatório.",
				"en": "If the protocol outputs body density, Siri or Brozek converter is required."
			},
			"rule": "densityConverterId is required when selectedBodyFatProtocol.output === 'bodyDensity'"
		},
		{
			"id": "bmiMeasurementsRequired",
			"description": {
				"pt-BR": "Massa corporal e estatura são obrigatórias para todos os IMCs.",
				"en": "Body mass and height are required for all BMI formulas."
			},
			"rule": "bodyMassKg and heightCm are required"
		},
		{
			"id": "waistHipRatioRequiredMeasurements",
			"description": {
				"pt-BR": "Cintura e quadril são obrigatórios quando relação cintura-quadril estiver ativa.",
				"en": "Waist and hip are required when waist-hip ratio is enabled."
			},
			"rule": "waistCircumferenceCm and hipCircumferenceCm are required when enabledHealthIndices includes 'waistHipRatio'"
		},
		{
			"id": "waistHeightRatioRequiredMeasurements",
			"description": {
				"pt-BR": "Cintura e estatura são obrigatórias quando relação cintura-estatura estiver ativa.",
				"en": "Waist and height are required when waist-height ratio is enabled."
			},
			"rule": "waistCircumferenceCm and heightCm are required when enabledHealthIndices includes 'waistHeightRatio'"
		},
		{
			"id": "targetBodyMassRequiredInputs",
			"description": {
				"pt-BR": "Percentual de gordura alvo é obrigatório quando cálculo de massa corporal alvo estiver ativo.",
				"en": "Target body fat percentage is required when target body mass calculation is enabled."
			},
			"rule": "targetBodyFatPercent is required when enabledBodyCompositionCalculations includes 'targetBodyMass'"
		},
		{
			"id": "activityFactorRequired",
			"description": {
				"pt-BR": "Fator de atividade é obrigatório quando gasto energético diário estiver ativo.",
				"en": "Activity factor is required when daily energy expenditure is enabled."
			},
			"rule": "activityFactor is required when enabledEnergyCalculations includes 'tdee'"
		}
	],
	"computedFields": [
		{
			"key": "ageYears",
			"source": "client.dateOfBirth + evaluatedAt",
			"calculation": "completedYearsBetween(client.dateOfBirth, evaluatedAt)",
			"visible": false,
			"editable": false
		},
		{
			"key": "heightM",
			"source": "heightCm",
			"calculation": "heightCm / 100",
			"visible": false,
			"editable": false
		},
		{
			"key": "bodyDensity",
			"source": "selectedBodyFatProtocol",
			"calculation": "apply selectedBodyFatProtocol formula when output is bodyDensity",
			"visible": false,
			"editable": false
		},
		{
			"key": "bodyFatPercent",
			"source": "selectedBodyFatProtocol + densityConverterId",
			"calculation": "apply selected protocol and converter when applicable",
			"visible": false,
			"editable": false
		},
		{
			"key": "fatMassKg",
			"source": ["bodyMassKg", "bodyFatPercent"],
			"calculation": "bodyMassKg * (bodyFatPercent / 100)",
			"visible": false,
			"editable": false
		},
		{
			"key": "fatFreeMassKg",
			"source": ["bodyMassKg", "fatMassKg"],
			"calculation": "bodyMassKg - fatMassKg",
			"visible": false,
			"editable": false
		}
	],
	"snapshots": {
		"clientSnapshot": [
			"clientId",
			"fullName",
			"dateOfBirth",
			"ageYears",
			"biologicalSex",
			"primaryPhone",
			"legalGuardian",
			"emergencyContacts"
		],
		"professionalSnapshot": [
			"professionalId",
			"displayName",
			"professionalTitle",
			"professionalRegistrations",
			"professionalPhone",
			"professionalEmail"
		],
		"generalAnamnesisSnapshot": [
			"generalAnamnesisId",
			"reviewedAnswers",
			"reviewedAt",
			"reviewedByProfessionalId"
		],
		"protocolSnapshot": [
			"bodyFatProtocolId",
			"densityConverterId",
			"enabledBmiFormulas",
			"enabledHealthIndices",
			"enabledBodyCompositionCalculations",
			"enabledEnergyCalculations"
		]
	},
	"submitRules": {
		"canSaveDraftWhen": [
			"clientId is valid",
			"professionalId is valid",
			"assessmentType === 'basicAnthropometric'",
			"evaluatedAt is valid"
		],
		"canCompleteWhen": [
			"clientId is valid",
			"professionalId is valid",
			"bodyFatProtocolId is valid",
			"all dynamic required measurements are valid",
			"all enabled calculation required inputs are valid",
			"clientTruthConfirmed === true",
			"specificAssessmentTruthConfirmed === true",
			"interferenceAwarenessConfirmed === true",
			"measurementAuthorizationConfirmed === true",
			"physicalContactAwarenessConfirmed === true",
			"professionalReviewedAnamnesis === true"
		],
		"onSaveDraft": [
			"set updatedAt",
			"save current answers",
			"save current measurements",
			"preserve draft status"
		],
		"onComplete": [
			"validate dynamic required fields",
			"compute ageYears",
			"compute protocol outputs",
			"compute enabled calculations",
			"save client snapshot",
			"save professional snapshot",
			"save general anamnesis snapshot",
			"save protocol snapshot",
			"set confirmationAt",
			"set completedAt",
			"set assessmentStatus to completed"
		]
	}
}
