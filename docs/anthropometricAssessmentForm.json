{
	"formId": "anthropometricAssessmentForm",
	"entity": "AnthropometricAssessment",
	"version": 1,
	"defaultLocale": "pt-BR",
	"supportedLocales": ["pt-BR", "en"],
	"title": {
		"pt-BR": "Avaliação antropométrica básica",
		"en": "Basic anthropometric assessment"
	},
	"description": {
		"pt-BR": "Formulário de coleta para avaliação antropométrica básica com balança, estadiômetro, fita métrica e adipômetro.",
		"en": "Data collection form for a basic anthropometric assessment using scale, stadiometer, measuring tape, and skinfold caliper."
	},
	"constraints": {
		"usesMeasuringTape": true,
		"usesSkinfoldCaliper": true,
		"usesBoneCaliper": false,
		"usesBoneDiameters": false,
		"usesFullCineanthropometry": false
	},
	"sections": [
		{
			"id": "systemControl",
			"order": 0,
			"visible": false,
			"title": {
				"pt-BR": "Controle interno",
				"en": "Internal control"
			},
			"fields": [
				{
					"key": "assessmentId",
					"type": "uuid",
					"required": true,
					"visible": false,
					"editable": false,
					"computed": true,
					"calculation": "crypto.randomUUID()"
				},
				{
					"key": "assessmentStatus",
					"type": "enum",
					"required": true,
					"visible": false,
					"editable": false,
					"defaultValue": "draft",
					"options": ["draft", "completed"]
				},
				{
					"key": "createdAt",
					"type": "datetime",
					"required": true,
					"visible": false,
					"editable": false,
					"computed": true,
					"calculation": "new Date().toISOString()"
				},
				{
					"key": "updatedAt",
					"type": "datetime",
					"required": true,
					"visible": false,
					"editable": false,
					"computed": true,
					"calculation": "new Date().toISOString()"
				},
				{
					"key": "completedAt",
					"type": "datetime",
					"required": false,
					"visible": false,
					"editable": false,
					"computed": true,
					"calculation": "assessmentStatus === 'completed' ? new Date().toISOString() : null"
				}
			]
		},
		{
			"id": "assessmentStart",
			"order": 1,
			"title": {
				"pt-BR": "Início da avaliação",
				"en": "Assessment start"
			},
			"fields": [
				{
					"key": "assessmentType",
					"type": "enum",
					"required": true,
					"visible": true,
					"editable": false,
					"defaultValue": "basicAnthropometric",
					"label": {
						"pt-BR": "Tipo de avaliação",
						"en": "Assessment type"
					},
					"options": [
						{
							"value": "basicAnthropometric",
							"label": {
								"pt-BR": "Avaliação antropométrica básica",
								"en": "Basic anthropometric assessment"
							}
						}
					]
				},
				{
					"key": "clientId",
					"type": "foreignKey",
					"required": true,
					"visible": true,
					"editable": true,
					"references": "Client",
					"label": {
						"pt-BR": "Cliente",
						"en": "Client"
					},
					"behavior": {
						"ifOpenedFromClientProfile": "preselectClientAndAllowChangeIfUserHasPermission",
						"ifOpenedFromAssessmentsArea": "requireManualSelection"
					},
					"errorMessages": {
						"required": {
							"pt-BR": "Selecione o cliente avaliado.",
							"en": "Select the assessed client."
						}
					}
				},
				{
					"key": "professionalId",
					"type": "foreignKey",
					"required": true,
					"visible": true,
					"editable": true,
					"references": "ProfessionalProfile",
					"label": {
						"pt-BR": "Profissional avaliador",
						"en": "Assessing professional"
					},
					"errorMessages": {
						"required": {
							"pt-BR": "Selecione o profissional avaliador.",
							"en": "Select the assessing professional."
						}
					}
				},
				{
					"key": "evaluatedAt",
					"type": "datetime",
					"required": true,
					"visible": true,
					"editable": true,
					"computed": true,
					"defaultValue": "new Date().toISOString()",
					"label": {
						"pt-BR": "Data e hora da avaliação",
						"en": "Assessment date and time"
					}
				}
			]
		},
		{
			"id": "protocolsAndCalculations",
			"order": 2,
			"title": {
				"pt-BR": "Protocolos e cálculos",
				"en": "Protocols and calculations"
			},
			"fields": [
				{
					"key": "bodyFatProtocolId",
					"type": "enum",
					"required": true,
					"visible": true,
					"editable": true,
					"label": {
						"pt-BR": "Protocolo de percentual de gordura",
						"en": "Body fat protocol"
					},
					"optionsSource": "protocolDefinitions.bodyFatProtocols",
					"filterRules": [
						"show protocol when client age and biological sex are compatible",
						"allow manual override with professional warning"
					],
					"errorMessages": {
						"required": {
							"pt-BR": "Selecione o protocolo de percentual de gordura.",
							"en": "Select the body fat protocol."
						}
					}
				},
				{
					"key": "densityConverterId",
					"type": "enum",
					"required": false,
					"requiredWhen": "selectedBodyFatProtocol.output === 'bodyDensity'",
					"visibleWhen": "selectedBodyFatProtocol.output === 'bodyDensity'",
					"editable": true,
					"label": {
						"pt-BR": "Conversor de densidade corporal",
						"en": "Body density converter"
					},
					"options": [
						{
							"value": "siri",
							"label": {
								"pt-BR": "Siri",
								"en": "Siri"
							}
						},
						{
							"value": "brozek",
							"label": {
								"pt-BR": "Brozek",
								"en": "Brozek"
							}
						}
					],
					"errorMessages": {
						"required": {
							"pt-BR": "Selecione o conversor de densidade corporal.",
							"en": "Select the body density converter."
						}
					}
				},
				{
					"key": "enabledBmiFormulas",
					"type": "arrayEnum",
					"required": true,
					"visible": true,
					"editable": false,
					"label": {
						"pt-BR": "Fórmulas de IMC",
						"en": "BMI formulas"
					},
					"defaultValue": ["quetelet", "greccoFmrpUsp", "trefethen", "melaoJr"]
				},
				{
					"key": "enabledHealthIndices",
					"type": "arrayEnum",
					"required": true,
					"visible": true,
					"editable": true,
					"label": {
						"pt-BR": "Índices de saúde",
						"en": "Health indices"
					},
					"defaultValue": ["waistHipRatio", "waistHeightRatio"],
					"options": [
						{
							"value": "waistHipRatio",
							"label": {
								"pt-BR": "Relação cintura-quadril",
								"en": "Waist-hip ratio"
							}
						},
						{
							"value": "waistHeightRatio",
							"label": {
								"pt-BR": "Relação cintura-estatura",
								"en": "Waist-height ratio"
							}
						}
					]
				},
				{
					"key": "enabledBodyCompositionCalculations",
					"type": "arrayEnum",
					"required": true,
					"visible": true,
					"editable": true,
					"label": {
						"pt-BR": "Cálculos de composição corporal",
						"en": "Body composition calculations"
					},
					"defaultValue": ["fatMass", "fatFreeMass", "fatFreeMassPercent"],
					"options": [
						{
							"value": "fatMass",
							"label": {
								"pt-BR": "Massa gorda",
								"en": "Fat mass"
							}
						},
						{
							"value": "fatFreeMass",
							"label": {
								"pt-BR": "Massa livre de gordura",
								"en": "Fat-free mass"
							}
						},
						{
							"value": "fatFreeMassPercent",
							"label": {
								"pt-BR": "Percentual de massa livre de gordura",
								"en": "Fat-free mass percentage"
							}
						},
						{
							"value": "fatToFatFreeMassRatio",
							"label": {
								"pt-BR": "Razão massa gorda / massa livre de gordura",
								"en": "Fat mass / fat-free mass ratio"
							}
						},
						{
							"value": "targetBodyMass",
							"label": {
								"pt-BR": "Massa corporal alvo por percentual de gordura",
								"en": "Target body mass by body fat percentage"
							}
						}
					]
				},
				{
					"key": "enabledEnergyCalculations",
					"type": "arrayEnum",
					"required": true,
					"visible": true,
					"editable": true,
					"label": {
						"pt-BR": "Cálculos energéticos",
						"en": "Energy calculations"
					},
					"defaultValue": ["mifflinStJeorBmr", "tdee"],
					"options": [
						{
							"value": "mifflinStJeorBmr",
							"label": {
								"pt-BR": "Taxa metabólica basal — Mifflin-St Jeor",
								"en": "Basal metabolic rate — Mifflin-St Jeor"
							}
						},
						{
							"value": "katchMcArdleBmr",
							"label": {
								"pt-BR": "Taxa metabólica basal — Katch-McArdle",
								"en": "Basal metabolic rate — Katch-McArdle"
							}
						},
						{
							"value": "tdee",
							"label": {
								"pt-BR": "Gasto energético diário estimado",
								"en": "Estimated total daily energy expenditure"
							}
						}
					]
				}
			]
		},
		{
			"id": "generalAnamnesisReview",
			"order": 3,
			"title": {
				"pt-BR": "Anamnese reaproveitada do cliente",
				"en": "Reused client anamnesis"
			},
			"fields": [
				{
					"key": "generalAnamnesisId",
					"type": "foreignKey",
					"required": false,
					"visible": true,
					"editable": false,
					"references": "GeneralAnamnesis",
					"label": {
						"pt-BR": "Anamnese geral vinculada",
						"en": "Linked general anamnesis"
					}
				},
				{
					"key": "generalAnamnesisStatus",
					"type": "enum",
					"required": false,
					"visible": true,
					"editable": false,
					"label": {
						"pt-BR": "Status da anamnese geral",
						"en": "General anamnesis status"
					},
					"options": ["notStarted", "draft", "completed", "needsReview"]
				},
				{
					"key": "anamnesisReviewMode",
					"type": "enum",
					"required": true,
					"visible": true,
					"editable": true,
					"label": {
						"pt-BR": "Modo de uso da anamnese",
						"en": "Anamnesis usage mode"
					},
					"defaultValue": "reuseAndReview",
					"options": [
						{
							"value": "reuseAndReview",
							"label": {
								"pt-BR": "Reaproveitar respostas e revisar",
								"en": "Reuse answers and review"
							}
						},
						{
							"value": "assessmentOnly",
							"label": {
								"pt-BR": "Usar respostas apenas nesta avaliação",
								"en": "Use answers only in this assessment"
							}
						}
					]
				},
				{
					"key": "allowGeneralAnamnesisUpdateFromAssessment",
					"type": "boolean",
					"required": true,
					"visible": true,
					"editable": true,
					"defaultValue": true,
					"label": {
						"pt-BR": "Permitir atualizar a anamnese geral a partir desta avaliação",
						"en": "Allow updating the general anamnesis from this assessment"
					}
				},
				{
					"key": "reviewedGeneralAnamnesisSections",
					"type": "arrayEnum",
					"required": false,
					"visible": true,
					"editable": true,
					"label": {
						"pt-BR": "Seções revisadas",
						"en": "Reviewed sections"
					},
					"options": [
						"goals",
						"health",
						"warningSigns",
						"medicationsAndSupplements",
						"allergiesAndRestrictions",
						"painInjuriesAndLimitations",
						"physicalActivityAndRoutine",
						"sleepStressAndHabits",
						"nutritionAndHydration",
						"reproductiveHealth",
						"familyHistory"
					]
				}
			]
		},
		{
			"id": "specificAnamnesis",
			"order": 4,
			"title": {
				"pt-BR": "Anamnese específica da avaliação antropométrica",
				"en": "Specific anamnesis for anthropometric assessment"
			},
			"fields": [
				{
					"key": "hadIntenseTrainingLast24h",
					"type": "boolean",
					"required": true,
					"visible": true,
					"editable": true,
					"label": {
						"pt-BR": "Praticou treino intenso nas últimas 24 horas?",
						"en": "Had intense training in the last 24 hours?"
					}
				},
				{
					"key": "hadAlcoholLast24h",
					"type": "boolean",
					"required": true,
					"visible": true,
					"editable": true,
					"label": {
						"pt-BR": "Ingeriu bebida alcoólica nas últimas 24 horas?",
						"en": "Consumed alcohol in the last 24 hours?"
					}
				},
				{
					"key": "sleptVeryPoorlyLastNight",
					"type": "boolean",
					"required": true,
					"visible": true,
					"editable": true,
					"label": {
						"pt-BR": "Dormiu muito mal na noite anterior?",
						"en": "Slept very poorly last night?"
					}
				},
				{
					"key": "hadHeavyMealLast3h",
					"type": "boolean",
					"required": true,
					"visible": true,
					"editable": true,
					"label": {
						"pt-BR": "Fez refeição pesada nas últimas 3 horas?",
						"en": "Had a heavy meal in the last 3 hours?"
					}
				},
				{
					"key": "isFastingOrRestrictingFoodToday",
					"type": "boolean",
					"required": true,
					"visible": true,
					"editable": true,
					"label": {
						"pt-BR": "Está em jejum prolongado ou restrição alimentar intensa hoje?",
						"en": "Is fasting for a long period or under intense food restriction today?"
					}
				},
				{
					"key": "hasFluidRetentionOrSwellingToday",
					"type": "boolean",
					"required": true,
					"visible": true,
					"editable": true,
					"label": {
						"pt-BR": "Percebe retenção de líquido, inchaço ou edema hoje?",
						"en": "Has fluid retention, swelling, or edema today?"
					}
				},
				{
					"key": "usesWeightOrHydrationAffectingMedication",
					"type": "boolean",
					"required": true,
					"visible": true,
					"editable": true,
					"label": {
						"pt-BR": "Usa medicamento que possa alterar peso, retenção hídrica ou composição corporal?",
						"en": "Uses medication that may affect weight, fluid retention, or body composition?"
					}
				},
				{
					"key": "usesWeightOrHydrationAffectingSupplement",
					"type": "boolean",
					"required": true,
					"visible": true,
					"editable": true,
					"label": {
						"pt-BR": "Usa suplemento que possa alterar peso, hidratação, volume muscular ou desempenho?",
						"en": "Uses supplement that may affect weight, hydration, muscle volume, or performance?"
					}
				},
				{
					"key": "hasSkinLesionPainOrDiscomfortInMeasurementArea",
					"type": "boolean",
					"required": true,
					"visible": true,
					"editable": true,
					"label": {
						"pt-BR": "Há feridas, lesões de pele, dor local ou desconforto em alguma região a ser medida?",
						"en": "Are there wounds, skin lesions, local pain, or discomfort in any area to be measured?"
					}
				},
				{
					"key": "restrictedMeasurementAreas",
					"type": "textarea",
					"required": false,
					"visible": true,
					"editable": true,
					"label": {
						"pt-BR": "Regiões que não devem ser medidas hoje",
						"en": "Areas that should not be measured today"
					},
					"validation": {
						"maxLength": 1000,
						"trim": true,
						"emptyToNull": true
					}
				}
			]
		},
		{
			"id": "collectionConditions",
			"order": 5,
			"title": {
				"pt-BR": "Condições da coleta",
				"en": "Collection conditions"
			},
			"fields": [
				{
					"key": "assessmentLocation",
					"type": "string",
					"required": false,
					"visible": true,
					"editable": true,
					"label": {
						"pt-BR": "Local da avaliação",
						"en": "Assessment location"
					},
					"validation": {
						"maxLength": 250,
						"trim": true,
						"emptyToNull": true
					}
				},
				{
					"key": "collectionCondition",
					"type": "enum",
					"required": true,
					"visible": true,
					"editable": true,
					"label": {
						"pt-BR": "Condição geral da coleta",
						"en": "General collection condition"
					},
					"defaultValue": "normal",
					"options": [
						{
							"value": "normal",
							"label": {
								"pt-BR": "Normal",
								"en": "Normal"
							}
						},
						{
							"value": "hasInterferingFactor",
							"label": {
								"pt-BR": "Cliente relatou fator que pode interferir",
								"en": "Client reported a possible interfering factor"
							}
						},
						{
							"value": "partialCollection",
							"label": {
								"pt-BR": "Coleta parcial",
								"en": "Partial collection"
							}
						},
						{
							"value": "restrictedCollection",
							"label": {
								"pt-BR": "Coleta com restrições",
								"en": "Restricted collection"
							}
						}
					]
				},
				{
					"key": "usedInstruments",
					"type": "arrayEnum",
					"required": true,
					"visible": true,
					"editable": true,
					"label": {
						"pt-BR": "Instrumentos usados",
						"en": "Used instruments"
					},
					"defaultValue": ["scale", "stadiometer", "measuringTape", "skinfoldCaliper"],
					"options": [
						{
							"value": "scale",
							"label": {
								"pt-BR": "Balança",
								"en": "Scale"
							}
						},
						{
							"value": "stadiometer",
							"label": {
								"pt-BR": "Estadiômetro",
								"en": "Stadiometer"
							}
						},
						{
							"value": "measuringTape",
							"label": {
								"pt-BR": "Fita métrica",
								"en": "Measuring tape"
							}
						},
						{
							"value": "skinfoldCaliper",
							"label": {
								"pt-BR": "Adipômetro",
								"en": "Skinfold caliper"
							}
						}
					]
				},
				{
					"key": "instrumentNotes",
					"type": "textarea",
					"required": false,
					"visible": true,
					"editable": true,
					"label": {
						"pt-BR": "Marca/modelo ou observações dos instrumentos",
						"en": "Instrument brand/model or notes"
					},
					"validation": {
						"maxLength": 1000,
						"trim": true,
						"emptyToNull": true
					}
				},
				{
					"key": "defaultCollectionSide",
					"type": "enum",
					"required": true,
					"visible": true,
					"editable": true,
					"defaultValue": "right",
					"label": {
						"pt-BR": "Lado padrão de coleta",
						"en": "Default collection side"
					},
					"options": [
						{
							"value": "right",
							"label": {
								"pt-BR": "Direito",
								"en": "Right"
							}
						},
						{
							"value": "left",
							"label": {
								"pt-BR": "Esquerdo",
								"en": "Left"
							}
						},
						{
							"value": "both",
							"label": {
								"pt-BR": "Ambos, quando aplicável",
								"en": "Both, when applicable"
							}
						}
					]
				},
				{
					"key": "collectionNotes",
					"type": "textarea",
					"required": false,
					"visible": true,
					"editable": true,
					"label": {
						"pt-BR": "Observações da coleta",
						"en": "Collection notes"
					},
					"validation": {
						"maxLength": 2000,
						"trim": true,
						"emptyToNull": true
					}
				}
			]
		},
		{
			"id": "generalMeasurements",
			"order": 6,
			"title": {
				"pt-BR": "Medidas gerais",
				"en": "General measurements"
			},
			"fields": [
				{
					"key": "bodyMassKg",
					"type": "number",
					"required": true,
					"visible": true,
					"editable": true,
					"unit": "kg",
					"label": {
						"pt-BR": "Massa corporal",
						"en": "Body mass"
					},
					"validation": {
						"min": 1,
						"max": 700,
						"decimals": 2
					}
				},
				{
					"key": "heightCm",
					"type": "number",
					"required": true,
					"visible": true,
					"editable": true,
					"unit": "cm",
					"label": {
						"pt-BR": "Estatura",
						"en": "Height"
					},
					"validation": {
						"min": 30,
						"max": 260,
						"decimals": 1
					}
				},
				{
					"key": "wingspanCm",
					"type": "number",
					"required": false,
					"visible": true,
					"editable": true,
					"unit": "cm",
					"label": {
						"pt-BR": "Envergadura",
						"en": "Wingspan"
					},
